        </button>
      </div>
    </div>
  </header>

  <!-- 1. HERO SECTION (Asymmetric Split & Floating Card like reference design) -->
  <section class="relative overflow-hidden bg-[#e7e1d4] pt-6 pb-16 md:pt-10 md:pb-24 border-b border-sand-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative">
        
        <!-- Cột trái: Khối màu Khaki / Xô Thơm với Thẻ Nổi Linen đè lên -->
        <div class="lg:col-span-6 relative z-10">
          <div class="bg-khaki-500/90 p-6 sm:p-10 rounded-sm relative shadow-md">
            
            <!-- Con dấu tròn xoay nhẹ đặc trưng phong cách Healing -->
            <div class="absolute -top-7 -right-5 sm:-top-8 sm:-right-8 w-24 h-24 sm:w-28 sm:h-28 z-20 pointer-events-none">
              <svg viewBox="0 0 100 100" class="w-full h-full stamp-rotate">
                <path id="circlePath" d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="none" />
                <text font-size="9.5" fill="#BA8448" letter-spacing="2.8" font-family="'Playfair Display', serif" font-weight="600">
                  <textPath href="#circlePath">✦ 60 NGÀY • YÊU LẠI TIẾNG TRUNG •</textPath>
                </text>
              </svg>
              <div class="absolute inset-0 flex items-center justify-center text-ochre-500 text-sm">🌿</div>
            </div>

            <!-- Khung thẻ nổi màu Kem (Linen Card) như ảnh mẫu -->
            <div class="bg-[#faf8f4] p-6 sm:p-9 shadow-lg border border-sand-300 relative">
              <span class="block text-[11px] uppercase tracking-[0.25em] text-ochre-600 font-semibold mb-3">
                Lộ trình chữa lành & kích hoạt phản xạ
              </span>
              <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-moss-950 leading-[1.2] mb-4">
                Bạn không kém <br/>
                tiếng Trung như <br/>
                <span class="italic font-serif text-ochre-600">bạn vẫn nghĩ.</span>
              </h1>
              <p class="text-moss-800 text-xs sm:text-sm leading-relaxed mb-6 font-normal">
                Bạn không cần bắt đầu lại từ con số 0. Bạn chỉ cần một cách học 
                <strong>đủ rõ ràng, đủ nhỏ và đủ an toàn</strong> để dùng lại những gì mình đã tích lũy — rồi từng bước tin rằng: <em class="font-serif text-ochre-700">mình có thể.</em>
              </p>
              
              <div class="flex flex-col sm:flex-row gap-3 pt-2">
                <button onclick="openModal('surveyModal', 'Gói Tiêu Chuẩn')" class="bg-ochre-500 hover:bg-ochre-600 text-sand-50 text-xs uppercase tracking-widest font-semibold px-6 py-3.5 transition text-center shadow-sm">
                  Đăng ký khảo sát đầu vào &rarr;
                </button>
                <a href="#tam-su" class="inline-block border border-moss-800 hover:bg-moss-800 hover:text-sand-50 text-moss-950 text-xs uppercase tracking-widest font-semibold px-6 py-3.5 transition text-center">
                  Đọc tâm sự
                </a>
              </div>
            </div>

          </div>
        </div>

        <!-- Cột phải: Hình ảnh phong cách yên bình, chữa lành -->
        <div class="lg:col-span-6 relative">
          <div class="relative overflow-hidden shadow-xl border-4 border-[#faf8f4] max-h-[580px]">
            <img src="https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=1200&q=80" 
                 alt="Không gian học tiếng Trung an yên và tĩnh lặng" 
                 class="w-full h-full object-cover object-center transform hover:scale-105 transition-transform duration-700"
                 onerror="this.src='https://placehold.co/900x1200/8c937b/faf8f4?text=Yeu+Lai+Tieng+Trung'">
