    <div class="max-w-6xl mx-auto px-4 sm:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-[11px] uppercase tracking-[0.25em] text-ochre-600 font-semibold block mb-2">Lựa chọn lộ trình</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-moss-950 font-normal">Bắt Đầu Hành Trình Của Bạn</h2>
        <p class="text-xs sm:text-sm text-moss-700 mt-2">Áp dụng mức trợ giá đặc biệt cho đợt thử nghiệm (tối đa 3–5 học viên).</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
        
        <!-- Thẻ 1: Gói Cơ Bản (Hoa Sen - Lotus Line-art) -->
        <div class="bg-[#faf8f4] p-8 border border-sand-300 shadow-sm flex flex-col justify-between text-center hover:border-khaki-500 transition">
          <div>
