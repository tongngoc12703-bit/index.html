                <label class="flex items-center gap-1.5"><input type="checkbox" name="modal_supportNeeds" value="Sửa phát âm" class="accent-ochre-600"> Sửa phát âm & thanh điệu</label>
                <label class="flex items-center gap-1.5"><input type="checkbox" name="modal_supportNeeds" value="Sửa bài nói" class="accent-ochre-600"> Sửa bài nói & nắn câu</label>
                <label class="flex items-center gap-1.5"><input type="checkbox" name="modal_supportNeeds" value="Nhắc nhở học tập" class="accent-ochre-600"> Nhắc nhở & đôn đốc</label>
              </div>
            </div>

            <button type="submit" class="w-full py-3.5 bg-ochre-500 hover:bg-ochre-600 active:scale-95 text-sand-50 text-xs uppercase tracking-widest font-semibold transition shadow">
              Hoàn Tất Khảo Sát & Gửi Giữ Chỗ
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>

  <!-- MODAL XÁC NHẬN THÀNH CÔNG -->
  <div id="successModal" class="fixed inset-0 bg-moss-950/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-[#faf8f4] max-w-md w-full p-8 text-center border border-sand-300 shadow-2xl">
      <div class="w-12 h-12 bg-sand-200 text-ochre-600 text-xl flex items-center justify-center mx-auto mb-3">
        ✓
      </div>
      <h3 class="font-serif text-2xl font-normal text-moss-950 mb-2">Đã Nhận Khảo Sát & Giữ Chỗ!</h3>
      <p class="text-xs text-moss-700 leading-relaxed mb-6">
        Cảm ơn bạn đã tin tưởng chia sẻ. Ngọc sẽ xem xét kỹ thông tin và trực tiếp nhắn tin qua Zalo cho bạn trong vòng 24 giờ tới nhé!
      </p>
      <button onclick="closeModal('successModal')" class="w-full py-3 bg-moss-900 hover:bg-moss-800 text-sand-50 text-xs uppercase tracking-widest font-semibold transition">
        Cảm ơn Ngọc!
      </button>
    </div>
  </div>

  <!-- FOOTER EDITORIAL -->
  <footer class="bg-moss-950 text-sand-300 py-12 text-xs border-t border-moss-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <span class="font-serif italic text-base text-sand-50 font-bold block">Yêu Lại Tiếng Trung Sau 60 Ngày</span>
        <span class="text-moss-400 text-[11px]">Đồng hành bởi Tong Thi Ngoc</span>
      </div>
      <p class="text-moss-400 text-center sm:text-right text-[11px]">
        Bản quyền © 2026. Mọi quyền được bảo lưu.
      </p>
    </div>
  </footer>

  <!-- JAVASCRIPT LOGIC & GOOGLE APPS SCRIPT SYNC -->
  <script>
    // URL Web App Google Apps Script đã triển khai chính thức của bạn
    const GOOGLE_APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzVFpqYb4ddSIYPEIbfZUbtcBA9mjxQvPH9BqiFrUolsD3varBJ1THbLRupdcKoGq4M/exec";

    function openModal(modalId, packageName) {
      const modal = document.getElementById(modalId);
      if (modal) {
        if (packageName) {
          const matchingRadio = document.querySelector(`input[name="modal_package"][value*="${packageName}"]`);
          if (matchingRadio) matchingRadio.checked = true;
        }
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal(modalId) {
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.add('hidden');
        document.body.style.overflow = 'auto';
      }
    }

    // Sao chép nội dung với phản hồi
    function copyContentWithFeedback(textToCopy, btnElement, itemName) {
      const performCopyFallback = () => {
        const textArea = document.createElement("textarea");
        textArea.value = textToCopy;
        textArea.style.position = "fixed";
        textArea.style.opacity = "0";
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try { document.execCommand('copy'); } catch (err) {}
        document.body.removeChild(textArea);
      };

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(textToCopy).catch(() => performCopyFallback());
      } else {
        performCopyFallback();
      }

      if (btnElement) {
        const textSpan = btnElement.querySelector('.btn-text');
        const originalText = textSpan ? textSpan.textContent : '';
        if (textSpan) textSpan.textContent = "Đã chép ✓";
        setTimeout(() => {
          if (textSpan) textSpan.textContent = originalText;
        }, 2000);
      }
    }

    // Xem trước ảnh chuyển khoản
    let uploadedReceiptFile = null;

    function previewReceiptImage(input, previewBoxId, dropzoneId, thumbImgId, fileNameId) {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        uploadedReceiptFile = file;
        const reader = new FileReader();

        reader.onload = function(e) {
          const thumb = document.getElementById(thumbImgId);
          const nameLabel = document.getElementById(fileNameId);
          const previewBox = document.getElementById(previewBoxId);
          const dropzone = document.getElementById(dropzoneId);

          if (thumb) thumb.src = e.target.result;
          if (nameLabel) nameLabel.textContent = file.name;
          if (dropzone) dropzone.classList.add('hidden');
          if (previewBox) {
            previewBox.classList.remove('hidden');
            previewBox.classList.add('flex');
          }
        };
        reader.readAsDataURL(file);
      }
    }

    function removeReceiptImage(inputId, previewBoxId, dropzoneId) {
      const input = document.getElementById(inputId);
      const previewBox = document.getElementById(previewBoxId);
      const dropzone = document.getElementById(dropzoneId);

      if (input) input.value = '';
      uploadedReceiptFile = null;
      if (previewBox) {
        previewBox.classList.add('hidden');
        previewBox.classList.remove('flex');
      }
      if (dropzone) dropzone.classList.remove('hidden');
    }

    function fileToBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = () => resolve(reader.result);
        reader.onerror = error => reject(error);
      });
    }

    // Gửi form & tải ảnh biên lai vào Google Drive / Sheet
    async function handleFormSubmit(e) {
      e.preventDefault();
      const form = e.target;
      const submitBtn = form.querySelector('button[type="submit"]');
      const originalBtnHtml = submitBtn.innerHTML;

      submitBtn.disabled = true;
      submitBtn.innerHTML = `<span>Đang gửi thông tin & tải biên lai...</span>`;

      try {
        let selectedPackage = "Gói Tiêu Chuẩn";
        const packageRadio = form.querySelector('input[type="radio"]:checked');
        if (packageRadio) selectedPackage = packageRadio.value;

        const textInputs = form.querySelectorAll('input[type="text"], input[type="tel"]');
        let fullName = "";
        let phone = "";
        if (textInputs.length >= 2) {
          fullName = textInputs[0].value.trim();
          phone = textInputs[1].value.trim();
        }

        const difficultyBoxes = form.querySelectorAll('input[type="checkbox"][name*="difficulties"]:checked');
        const difficulties = [];
        difficultyBoxes.forEach(box => difficulties.push(box.value));
        const difficultyTextarea = form.querySelector('textarea');
        const difficultyDetail = difficultyTextarea ? difficultyTextarea.value.trim() : "";

        const stoppingBoxes = form.querySelectorAll('input[type="checkbox"][name*="stoppingReasons"]:checked');
        const stoppingReasons = [];
        stoppingBoxes.forEach(box => stoppingReasons.push(box.value));
        const stopReasonInput = form.querySelector('input[name*="stoppingReasonDetail"]');
        const stoppingReasonDetail = stopReasonInput ? stopReasonInput.value.trim() : "";

        const expectationBoxes = form.querySelectorAll('input[type="checkbox"][name*="expectations"]:checked');
        const expectations = [];
        expectationBoxes.forEach(box => expectations.push(box.value));
        const expectationInput = form.querySelector('input[name*="expectationDetail"]');
        const expectationDetail = expectationInput ? expectationInput.value.trim() : "";

        let fileBase64 = null;
        let fileName = null;
        let fileType = null;

        // Kiểm tra file biên lai từ form tương ứng
        const fileInput = form.id === 'surveyModal' 
          ? document.getElementById('modalReceiptInput') 
          : (document.getElementById('pageReceiptInput') || document.getElementById('modalReceiptInput'));
          
        if (fileInput && fileInput.files && fileInput.files[0]) {
          const file = fileInput.files[0];
          fileName = file.name;
          fileType = file.type;
          fileBase64 = await fileToBase64(file);
        }

        const payload = {
          package: selectedPackage,
          fullName: fullName,
          phone: phone,
          difficulties: difficulties,
          difficultyDetail: difficultyDetail,
          stoppingReasons: stoppingReasons,
          stoppingReasonDetail: stoppingReasonDetail,
          expectations: expectations,
          expectationDetail: expectationDetail,
          fileBase64: fileBase64,
          fileName: fileName,
          fileType: fileType
        };

        if (GOOGLE_APPS_SCRIPT_URL) {
          await fetch(GOOGLE_APPS_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(payload)
          });
        }

        closeModal('surveyModal');
        form.reset();
        openModal('successModal');

      } catch (err) {
        console.error("Lỗi khi gửi:", err);
        closeModal('surveyModal');
        openModal('successModal');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
      }
    }

    window.onclick = function(event) {
      const surveyModal = document.getElementById('surveyModal');
      const successModal = document.getElementById('successModal');
      if (event.target === surveyModal) closeModal('surveyModal');
      if (event.target === successModal) closeModal('successModal');
    }
  </script>
</body>
