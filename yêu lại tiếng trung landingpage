    <a href="#dang-ky" class="underline ml-2 text-ochre-400 hover:text-sand-50 font-semibold normal-case">Giữ chỗ ngay &rarr;</a>
  </div>

  <!-- NAVIGATION HEADER (Minimalist Editorial Style) -->
  <header class="bg-[#e7e1d4]/95 backdrop-blur-md border-b border-sand-300 sticky top-0 z-40 transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 h-20 flex items-center justify-between">
      <div class="hidden md:flex items-center space-x-6 text-xs uppercase tracking-[0.2em] font-semibold text-moss-800">
        <a href="#thau-hieu" class="hover:text-ochre-600 transition">Thấu hiểu</a>
        <a href="#tam-su" class="hover:text-ochre-600 transition">Tâm sự</a>
        <a href="#phuong-phap" class="hover:text-ochre-600 transition">Phương pháp</a>
      </div>
      
      <a href="#" class="text-center group">
        <span class="block text-[10px] uppercase tracking-[0.3em] text-khaki-600 font-medium">Hành Trình 60 Ngày</span>
        <span class="font-serif italic text-2xl sm:text-3xl text-moss-950 font-bold tracking-tight">Yêu Lại Tiếng Trung</span>
      </a>

      <div class="flex items-center space-x-4">
