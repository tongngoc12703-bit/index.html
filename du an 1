      <div class="flex items-center gap-2">
        <span class="font-serif text-sm font-bold text-warmCream">MÊ TIẾNG TRUNG</span>
        <span>•</span>
        <span>Phương Pháp MÌNH CÓ THỂ™</span>
      </div>
      <div class="text-[11px] text-textLight/50">
        © 2026 Mê Tiếng Trung. All Rights Reserved.
      </div>
    </div>
  </footer>

  <!-- Toast Notification (Thay thế alert) -->
  <div id="toastMessage" style="display: none;" class="fixed bottom-5 right-5 z-[99999] bg-[#333824] text-warmCream border border-warmOchre p-4 shadow-xl text-xs max-w-sm rounded-[2px]">
    <div class="font-bold text-warmOchre mb-1" id="toastHeader">Thông báo</div>
    <div id="toastBody" class="font-light text-[11px]">Nội dung</div>
  </div>

  <script>
    // Bật/tắt menu trên di động
    function toggleNav() {
      const menu = document.getElementById('basicMobileMenu');
      if (menu) {
        menu.classList.toggle('hidden');
      }
    }
    document.getElementById('navToggle').addEventListener('click', toggleNav);

    // Toast thay thế alert()
    function displayToast(title, body) {
      const toast = document.getElementById('toastMessage');
      const header = document.getElementById('toastHeader');
      const text = document.getElementById('toastBody');
      if (!toast) return;
      header.textContent = title;
      text.textContent = body;
      toast.style.display = 'block';
      setTimeout(() => {
        toast.style.display = 'none';
      }, 4000);
    }

    // Sao chép an toàn qua execCommand
    function copyData(text, message) {
      const input = document.createElement('input');
      input.value = text;
      document.body.appendChild(input);
      input.select();
      try {
        document.execCommand('copy');
        displayToast('Sao chép thành công', message);
      } catch (err) {
        displayToast('Thông báo', 'Vui lòng sao chép thủ công: ' + text);
      }
      document.body.removeChild(input);
    }

    // Xử lý nộp form
    function submitEnrollment(e) {
      e.preventDefault();
      displayToast(
        'Đăng ký giữ chỗ thành công!',
        'Cảm ơn bạn! Cô Ngọc sẽ liên hệ qua Zalo/SĐT trong 24h để trao đổi và gửi bài khảo sát đầu vào (Mã giữ chỗ: N60).'
      );
      e.target.reset();
    }
  </script>

</body>
</html>
